      <data key="ontology_prefix">GO</data>
      <data key="short_form">GO_0033371</data>
      <data key="obo_id">GO:0033371</data>
      <data key="description">["A process that is carried out at the cellular level which results in the assembly, arrangement of constituent parts, or disassembly of a secretory granule in a T cell. A secretory granule is a small subcellular vesicle, surrounded by a membrane, that is formed from the Golgi apparatus and contains a highly concentrated protein destined for secretion."]</data>
      <data key="lang">en</data>
      <data key="label">T cell secretory granule organization</data>
      <data key="ontology_iri">http://purl.obolibrary.org/obo/go/extensions/go-plus.owl</data>
      <data key="synonyms">["T cell secretory granule organisation", "T lymphocyte secretory granule organization", "T-cell secretory granule organization", "T-lymphocyte secretory granule organization", "T cell secretory granule organization and biogenesis", "T-lymphocyte secretory granule maturation"]</data>
      <data key="is_preferred_root">false</data>
    </node>
